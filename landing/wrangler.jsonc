{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "backu",
  "main": "dist/server/server.js",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "none"
  },
  "routes": [
    {
      "pattern": "backu.app",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
